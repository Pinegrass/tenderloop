{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOnlyTenderLoopRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": [
        "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/TenderLoopStudentCoach-*",
        "arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/TenderLoopStudentCoach-*/runtime-endpoint/DEFAULT"
      ]
    },
    {
      "Sid": "DenyCallerSuppliedUserDelegation",
      "Effect": "Deny",
      "Action": "bedrock-agentcore:InvokeAgentRuntimeForUser",
      "Resource": "*"
    }
  ]
}
