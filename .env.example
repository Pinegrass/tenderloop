# Optional local/direct Bedrock path
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
TENDERLOOP_USE_BEDROCK=false

# Production AgentCore path. Keep values server-side.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_REGION=ap-south-1
AGENTCORE_QUALIFIER=DEFAULT

# Vercel OIDC role used only to invoke the configured runtime.
AWS_ROLE_ARN=
